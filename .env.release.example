# Notarization credentials for build.sh — copy to .env.release and fill in.
# .env.release is gitignored; never commit real secrets.
APPLE_ID=you@example.com
# App-specific password from appleid.apple.com → Sign-In and Security
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Updater signing (separate from Apple code signing). Default encrypted key:
# TAURI_SIGNING_PRIVATE_KEY=/path/to/nbp-updater.key
# Password is read from Keychain: service one.nbp.skk.updater-signing,
# account nbp-release. CI may supply TAURI_SIGNING_PRIVATE_KEY_PASSWORD.
# Never commit the private key or its password. Back up both securely.
