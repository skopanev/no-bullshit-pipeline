{
  "name": "nbp",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build:js": "bun esbuild.mjs",
    "build:js:dev": "bun esbuild.mjs --dev",
    "check:js": "bun esbuild.mjs",
    "lint": "eslint \"src/**/*.js\" --max-warnings=0",
    "check:all": "bun run lint && bun run check:js && bun run check",
    "doctor": "node scripts/doctor.mjs",
    "doctor:rust": "node scripts/doctor.mjs --rust-only",
    "dev": "bun run build:js:dev && bun run doctor:rust && tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "bun run build:js && tauri build",
    "tauri": "tauri",
    "build:release": "./build.sh",
    "update-packages": "rustup update && cargo update && bun update",
    "upgrade-packages": "cd src-tauri && cargo upgrade && cd .. && bun update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0"
  },
  "dependencies": {
    "marked": "^17.0.5",
    "ui-ux-pro-mcp": "^1.5.0"
  }
}
