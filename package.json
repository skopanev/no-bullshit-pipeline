{
  "name": "nbp",
  "private": true,
  "version": "0.4.29",
  "type": "module",
  "scripts": {
    "check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "build:js": "bun esbuild.mjs",
    "build:js:dev": "bun esbuild.mjs --dev",
    "check:js": "bun esbuild.mjs",
    "lint": "eslint \"src/**/*.js\" --max-warnings=0",
    "check:all": "bun run lint && bun run check:js && bun run check",
    "doctor": "node scripts/doctor.mjs",
    "doctor:rust": "node scripts/doctor.mjs --rust-only",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:sidecar:force": "node scripts/build-sidecar.mjs --force",
    "dev": "bun run doctor:rust && bun run build:sidecar && node scripts/dev.mjs",
    "build": "bun run build:js && bun run build:sidecar && tauri build",
    "tauri": "tauri",
    "build:release": "./build.sh",
    "clean": "rm -rf src-tauri/target src/dist fluidaudio-sidecar/.build apple-speech-sidecar/.build src-tauri/binaries/fluidaudio-sidecar-aarch64-apple-darwin src-tauri/binaries/apple-speech-sidecar-aarch64-apple-darwin",
    "update-packages": "rustup update && cargo update && bun update",
    "upgrade-packages": "cd src-tauri && cargo upgrade && cd .. && bun update",
    "bump": "node scripts/bump.mjs",
    "bump:minor": "node scripts/bump.mjs minor",
    "bump:major": "node scripts/bump.mjs major"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0"
  },
  "dependencies": {
    "ui-ux-pro-mcp": "^1.5.0"
  }
}
