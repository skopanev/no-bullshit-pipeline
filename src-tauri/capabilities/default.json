{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/nbp-data/**"
        }
      ]
    },
    "notification:default",
    "global-shortcut:default"
  ]
}